# Pick ONE provider. Gemini is used automatically if GEMINI_API_KEY is set.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash
# Or use Claude instead:
# ANTHROPIC_API_KEY=your-key-here
# CLAUDE_MODEL=claude-sonnet-5-5
# LLM_PROVIDER=gemini   # optional: force "gemini" or "claude"

# Only needed for the `send` step
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
# Optional display "From" address (defaults to SMTP_USER)
SMTP_FROM=
